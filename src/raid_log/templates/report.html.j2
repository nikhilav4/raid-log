{%- macro status(item) -%}
<span class="pill status-{{ item.status }}">{{ item.status }}</span>
{%- endmacro -%}
{%- macro exposure(item) -%}
<span class="exposure" style="background: {{ band_for(item.exposure).color }}">{{ item.exposure }}</span>
{%- endmacro -%}
{%- macro days_left(days) -%}
{% if days < 0 %}<span class="late">{{ -days }} late</span>{% else %}{{ days }}{% endif %}
{%- endmacro -%}
<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>RAID status: {{ register.title }}, {{ options.today }}</title>
<style>
  :root {
    --ink: #1d2733;
    --muted: #5f6b76;
    --line: #e1e5ea;
    --soft: #f4f6f8;
    --late: #b42318;
  }
  * { box-sizing: border-box; }
  body {
    margin: 0 auto;
    max-width: 1040px;
    padding: 2.5rem 1.5rem 3rem;
    color: var(--ink);
    background: #fff;
    font: 15px/1.5 -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, Helvetica, Arial, sans-serif;
  }
  .eyebrow {
    margin: 0;
    color: var(--muted);
    font-size: 0.8rem;
    font-weight: 600;
    letter-spacing: 0.06em;
    text-transform: uppercase;
  }
  h1 { margin: 0.2rem 0 0.3rem; font-size: 1.75rem; line-height: 1.2; }
  h2 { margin: 2.25rem 0 0.75rem; font-size: 1.1rem; }
  .meta { margin: 0; color: var(--muted); }
  .counts {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 0.75rem;
    margin-top: 1.75rem;
  }
  .count { padding: 0.85rem 1rem; border: 1px solid var(--line); border-radius: 8px; }
  .count .label { display: block; color: var(--muted); font-size: 0.85rem; }
  .count .n { font-size: 1.75rem; font-weight: 650; font-variant-numeric: tabular-nums; }
  .count .sub { color: var(--muted); font-size: 0.85rem; }
  .table-wrap { overflow-x: auto; }
  table { width: 100%; border-collapse: collapse; font-size: 0.9rem; }
  th, td { padding: 0.5rem 0.6rem; border-bottom: 1px solid var(--line); text-align: left; vertical-align: top; }
  th {
    color: var(--muted);
    font-size: 0.75rem;
    font-weight: 600;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    white-space: nowrap;
  }
  td.id, td.date, td.who { white-space: nowrap; font-variant-numeric: tabular-nums; }
  .num { text-align: right; white-space: nowrap; font-variant-numeric: tabular-nums; }
  .pill {
    display: inline-block;
    padding: 0.05rem 0.55rem;
    border-radius: 999px;
    background: var(--soft);
    font-size: 0.8rem;
    white-space: nowrap;
  }
  .status-mitigating { background: #e3eefc; }
  .status-monitoring { background: #eef0f3; }
  .status-open { background: #fff1d6; }
  .status-resolved, .status-closed { background: #e0f2e4; }
  .sev-critical { background: #fbd5d2; }
  .sev-high { background: #fde4cc; }
  .exposure {
    display: inline-block;
    min-width: 2.1rem;
    padding: 0.05rem 0.4rem;
    border-radius: 4px;
    font-weight: 650;
    text-align: center;
  }
  .late { color: var(--late); font-weight: 600; }
  .empty { margin: 0; color: var(--muted); }
  .changes { display: grid; grid-template-columns: 1fr 1fr; gap: 2rem; }
  .changes ul { margin: 0; padding-left: 1.1rem; }
  .changes li { margin-bottom: 0.5rem; }
  .changes .detail { display: block; color: var(--muted); font-size: 0.875rem; }
  figure.heatmap { margin: 1.5rem auto 0; max-width: 620px; }
  figure.heatmap svg { display: block; width: 100%; height: auto; }
  footer { margin-top: 3rem; color: var(--muted); font-size: 0.8rem; }
  @media (max-width: 760px) {
    .counts { grid-template-columns: repeat(2, minmax(0, 1fr)); }
    .changes { grid-template-columns: 1fr; }
  }
  @media print {
    body { max-width: none; padding: 0; font-size: 12px; }
    section { break-inside: avoid; }
    figure.heatmap { max-width: 480px; }
  }
</style>
</head>
<body>
<header>
  <p class="eyebrow">RAID status</p>
  <h1>{{ register.title }}</h1>
  <p class="meta">
    Report date {{ options.today }}
    {%- if register.updated %} &middot; register updated {{ register.updated }}{% endif %}
    &middot; changes counted from {{ options.since }}
  </p>
</header>

<section class="counts" aria-label="Items by type">
{% for item_type, (active, done) in report.counts.items() %}
  <div class="count">
    <span class="label">{{ plural[item_type] }}</span>
    <span class="n">{{ active }}</span> active
    <span class="sub">&middot; {{ done }} resolved or closed</span>
  </div>
{% endfor %}
</section>

<section>
  <h2>Top risks by exposure</h2>
{% if report.top_risks %}
  <div class="table-wrap">
  <table>
    <thead><tr><th>ID</th><th>Risk</th><th>Owner</th><th class="num">P x I</th><th class="num">Exposure</th><th>Status</th><th>Review by</th></tr></thead>
    <tbody>
{% for risk in report.top_risks %}
      <tr>
        <td class="id">{{ risk.id }}</td>
        <td>{{ risk.title }}{% if risk.mitigation %}<br><small>Mitigation: {{ risk.mitigation }}</small>{% endif %}</td>
        <td class="who">{{ risk.owner or "-" }}</td>
        <td class="num">{{ risk.probability }} x {{ risk.impact }}</td>
        <td class="num">{{ exposure(risk) }}</td>
        <td>{{ status(risk) }}</td>
        <td class="date">{{ risk.review_by or "-" }}</td>
      </tr>
{% endfor %}
    </tbody>
  </table>
  </div>
{% else %}
  <p class="empty">No active risks.</p>
{% endif %}
{% if heatmap %}
  <figure class="heatmap">{{ heatmap | safe }}</figure>
{% endif %}
</section>

<section class="changes">
  <div>
    <h2>New since {{ options.since }}</h2>
{% if report.new %}
    <ul>
{% for item in report.new %}
      <li><strong>{{ item.id }}</strong> {{ item.title }}
        <span class="detail">{{ item.type }}{% if item.exposure %}, exposure {{ item.exposure }}{% elif item.severity %}, {{ item.severity }}{% endif %} &middot; {{ item.owner or "no owner" }} &middot; raised {{ item.raised }}</span></li>
{% endfor %}
    </ul>
{% else %}
    <p class="empty">Nothing new.</p>
{% endif %}
  </div>
  <div>
    <h2>Resolved or closed since {{ options.since }}</h2>
{% if report.closed %}
    <ul>
{% for item in report.closed %}
      <li><strong>{{ item.id }}</strong> {{ item.title }}
        <span class="detail">{{ item.status }} {{ item.last_logged }} &middot; {{ item.resolution or "no resolution recorded" }}</span></li>
{% endfor %}
    </ul>
{% else %}
    <p class="empty">Nothing closed.</p>
{% endif %}
  </div>
</section>

<section>
  <h2>Overdue reviews</h2>
{% if report.overdue_reviews %}
  <div class="table-wrap">
  <table>
    <thead><tr><th>ID</th><th>Title</th><th>Owner</th><th>Review was due</th><th class="num">Days overdue</th></tr></thead>
    <tbody>
{% for d in report.overdue_reviews %}
      <tr><td class="id">{{ d.item.id }}</td><td>{{ d.item.title }}</td><td class="who">{{ d.item.owner or "-" }}</td><td class="date">{{ d.item.review_by }}</td><td class="num late">{{ d.days }}</td></tr>
{% endfor %}
    </tbody>
  </table>
  </div>
{% else %}
  <p class="empty">No overdue reviews.</p>
{% endif %}
</section>

<section>
  <h2>Issues open {{ options.aging_days }} days or more</h2>
{% if report.aging_issues %}
  <div class="table-wrap">
  <table>
    <thead><tr><th>ID</th><th>Issue</th><th>Owner</th><th>Severity</th><th>Status</th><th class="num">Age (days)</th></tr></thead>
    <tbody>
{% for d in report.aging_issues %}
      <tr><td class="id">{{ d.item.id }}</td><td>{{ d.item.title }}</td><td class="who">{{ d.item.owner or "-" }}</td><td>{% if d.item.severity %}<span class="pill sev-{{ d.item.severity }}">{{ d.item.severity }}</span>{% else %}-{% endif %}</td><td>{{ status(d.item) }}</td><td class="num">{{ d.days }}</td></tr>
{% endfor %}
    </tbody>
  </table>
  </div>
{% else %}
  <p class="empty">No aging issues.</p>
{% endif %}
</section>

<section>
  <h2>Dependencies due in the next {{ options.due_within }} days</h2>
{% if report.dependencies_due %}
  <div class="table-wrap">
  <table>
    <thead><tr><th>ID</th><th>Dependency</th><th>Counterparty</th><th>Owner</th><th>Need by</th><th class="num">Days left</th></tr></thead>
    <tbody>
{% for d in report.dependencies_due %}
      <tr><td class="id">{{ d.item.id }}</td><td>{{ d.item.title }}</td><td>{{ d.item.counterparty or "-" }}</td><td class="who">{{ d.item.owner or "-" }}</td><td class="date">{{ d.item.need_by }}</td><td class="num">{{ days_left(d.days) }}</td></tr>
{% endfor %}
    </tbody>
  </table>
  </div>
{% else %}
  <p class="empty">No dependencies due.</p>
{% endif %}
</section>

<section>
  <h2>Assumptions to validate in the next {{ options.due_within }} days</h2>
{% if report.assumptions_due %}
  <div class="table-wrap">
  <table>
    <thead><tr><th>ID</th><th>Assumption</th><th>Owner</th><th>Validate by</th><th class="num">Days left</th></tr></thead>
    <tbody>
{% for d in report.assumptions_due %}
      <tr><td class="id">{{ d.item.id }}</td><td>{{ d.item.title }}</td><td class="who">{{ d.item.owner or "-" }}</td><td class="date">{{ d.item.validate_by }}</td><td class="num">{{ days_left(d.days) }}</td></tr>
{% endfor %}
    </tbody>
  </table>
  </div>
{% else %}
  <p class="empty">No assumptions due for validation.</p>
{% endif %}
</section>

<footer>raid-log {{ version }}</footer>
</body>
</html>
